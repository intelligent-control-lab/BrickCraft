{
    "output_dir": "<output_dir>",
    "job_name": "<job_name>",
    "dataset": {
        "repo_id": "dummy",
        "root": "<dataset_root>",
        "use_imagenet_stats": false,
        "image_transforms": {
            "enable": true,
            "max_num_transforms": 3,
            "random_order": false,
            "tfs": {
                "brightness": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "brightness": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "contrast": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "contrast": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "saturation": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "saturation": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "hue": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": {
                        "hue": [
                            -0.04,
                            0.04
                        ]
                    }
                },
                "sharpness": {
                    "weight": 1.0,
                    "type": "SharpnessJitter",
                    "kwargs": {
                        "sharpness": [
                            0.8,
                            1.2
                        ]
                    }
                },
                "affine": {
                    "weight": 1.0,
                    "type": "RandomAffine",
                    "kwargs": {
                        "degrees": [
                            -3.0,
                            3.0
                        ],
                        "translate": [
                            0.05,
                            0.05
                        ]
                    }
                }
            }
        }
    },
    "policy": {
        "type": "brick_diffusion",
        "n_obs_steps": 2,
        "device": "cuda",
        "use_amp": false,
        "normalization_mapping": {
            "VISUAL": "MEAN_STD",
            "STATE": "MIN_MAX",
            "ACTION": "MIN_MAX",
            "LANGUAGE": "IDENTITY"
        },
        "input_features": {
            "observation.images.wrist_camera": {
                "type": "VISUAL",
                "shape": [
                    3,
                    256,
                    256
                ]
            },
            "observation.images.fixed_camera": {
                "type": "VISUAL",
                "shape": [
                    3,
                    256,
                    256
                ]
            },
            "observation.state": {
                "type": "STATE",
                "shape": [
                    13
                ]
            },
            "observation.task_encoding": {
                "type": "LANGUAGE",
                "shape": [
                    6
                ]
            }
        },
        "output_features": {
            "action": {
                "type": "ACTION",
                "shape": [
                    10
                ]
            }
        },
        "horizon": 16,
        "n_action_steps": 6,
        "drop_n_last_frames": 7,
        "vision_backbone": "resnet18",
        "crop_shape": [
            224,
            224
        ],
        "crop_is_random": true,
        "pretrained_backbone_weights": null,
        "freeze_batch_norm": false,
        
        "use_group_norm": true,
        "spatial_softmax_num_keypoints": 32,
        "use_separate_rgb_encoder_per_camera": true,
        "down_dims": [
            512,
            1024,
            2048
        ],

        "task_encoding_strategy": "embedding_MLP",
        "task_embedding_dim": 8,
        "task_num_categories": 8,
        "task_mlp_layer_dims": [64, 32],
        "task_encoding_offset": 3,

        "kernel_size": 5,
        "n_groups": 8,
        "diffusion_step_embed_dim": 128,
        "use_film_scale_modulation": true,
        "noise_scheduler_type": "DDIM",
        "num_train_timesteps": 100,
        "num_inference_steps": 10,
        "beta_schedule": "squaredcos_cap_v2",
        "beta_start": 0.0001,
        "beta_end": 0.02,
        "prediction_type": "epsilon",
        "clip_sample": true,
        "clip_sample_range": 1.05,
        "do_mask_loss_for_padding": false,
        "optimizer_lr": 0.0004,
        "optimizer_betas": [
            0.95,
            0.999
        ],
        "optimizer_eps": 1e-08,
        "optimizer_weight_decay": 1e-06,
        "scheduler_name": "cosine",
        "scheduler_warmup_steps": 500,
        "push_to_hub": false
    },
    "resume": false,
    "num_workers": 8,
    "batch_size": 128,
    "steps": 120000,
    "log_freq": 100,
    "save_checkpoint": true,
    "save_freq": 10000,
    "use_policy_training_preset": true,
    "optimizer": {
        "type": "adamw",
        "lr": 0.0004,
        "betas": [
            0.95,
            0.999
        ],
        "eps": 1e-08,
        "weight_decay": 1e-06,
        "grad_clip_norm": 10.0
    },
    "scheduler": {
        "type": "diffuser",
        "num_warmup_steps": 500,
        "name": "cosine"
    },
    "wandb": {
        "enable": false,
        "disable_artifact": true,
        "project": "<wandb_project>",
        "mode": "online"
    }
}
